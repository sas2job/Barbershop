<% content_for :title, "Перенос записи" %>

<main class="booking-page">
  <header class="booking-page__header">
    <p class="catalog__eyebrow">Онлайн-запись</p>
    <h1>Перенос записи</h1>
    <p><strong><%= @service.name %></strong></p>
  </header>

  <% if @booking.errors.any? %>
    <div class="form-errors" role="alert"><%= @booking.errors.full_messages.to_sentence %></div>
  <% end %>

  <%= form_with url: reschedule_booking_path(@booking.public_token), method: :get, class: "booking-date-form" do %>
    <div>
      <%= label_tag :date, "Дата" %>
      <%= hidden_field_tag :_method, "get" %>
      <%= date_field_tag :date, @date.iso8601, min: Date.current.iso8601, required: true, data: { booking_date: true, service_id: @service.id } %>
      <%= submit_tag "Показать время" %>
    </div>
  <% end %>

  <%= form_with url: reschedule_booking_path(@booking.public_token), method: :post, class: "booking-form" do %>
    <%= hidden_field_tag :date, @date.iso8601, data: { booking_date_value: true } %>
    <div>
      <%= label_tag "booking_starts_at", "Время" %>
      <%= select_tag "booking[starts_at]", options_for_select(@slots.map { |slot| [ slot.strftime("%H:%M"), slot.iso8601 ] }, params.dig(:booking, :starts_at)), include_blank: "Выберите время", required: true, data: { booking_slots: true } %>
    </div>
    <%= submit_tag "Подтвердить перенос", disabled: @slots.empty? %>
  <% end %>
</main>
