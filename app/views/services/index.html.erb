<% content_for :title, "Услуги — Барбершоп" %>

<main class="catalog">
  <header class="catalog__header">
    <p class="catalog__eyebrow">Онлайн-запись</p>
    <h1>Выберите услугу</h1>
    <p>Посмотрите доступные услуги и их длительность. Время визита можно будет выбрать на следующем шаге.</p>
  </header>

  <nav class="catalog__filters" aria-label="Фильтр по залу">
    <%= link_to "Все услуги", root_path, class: ("is-active" unless @category) %>
    <%= link_to "Женский зал", root_path(category: "women"), class: ("is-active" if @category == "women") %>
    <%= link_to "Мужской зал", root_path(category: "men"), class: ("is-active" if @category == "men") %>
  </nav>

  <% [["women", "Женский зал"], ["men", "Мужской зал"]].each do |category, title| %>
    <% services = @services_by_category.fetch(category, []) %>
    <% next if services.empty? %>

    <section class="service-group" aria-labelledby="<%= category %>-services">
      <h2 id="<%= category %>-services"><%= title %></h2>
      <div class="service-list">
        <% services.each do |service| %>
      <article class="service-card">
        <div>
          <h3><%= service.name %></h3>
          <p><%= service.duration_minutes %> мин.</p>
        </div>
        <%= link_to new_booking_path(service_id: service.id), class: "service-card__action" do %>
          <strong><%= service_price(service) %></strong>
          <span>Выбрать</span>
        <% end %>
      </article>
        <% end %>
      </div>
    </section>
  <% end %>
</main>
